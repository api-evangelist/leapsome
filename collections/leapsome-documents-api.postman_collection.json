        {
          "id": "d1edb205-a7b0-481e-9501-1834a7da9ed5",
          "name": "Upload user document",
          "request": {
            "name": "Upload user document",
            "description": {
              "content": "Upload a document to a user's profile in a single request. Send the file as\nmultipart/form-data along with the target category. The backend handles storage\nand confirmation automatically.\n\nMaximum file size: 25 MB.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                ":userId",
                "documents"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "userId",
                  "description": "(Required) Leapsome user ID of the document owner"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The document file to upload (max 25 MB)"
                },
                {
                  "key": "category",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) ID of the user document category (from GET /documents/categories)"
                },
                {
                  "key": "description",
                  "value": "<string>",
                  "type": "text",
                  "description": "Optional human-readable description for the document"
                }
              ]
            }
          },
          "response": [
