          "name": "List absences",
          "request": {
            "name": "List absences",
            "description": {
              "content": "Get a paginated list of absences in your Leapsome instance. You can filter by date range, \nstatus, and user. Requires admin permissions for absence management.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "absences"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "absenceStartFrom",
                  "value": "<dateTime>",
                  "description": "Filter absences that start on or after this date"
                },
                {
                  "disabled": false,
                  "key": "absenceStartUntil",
                  "value": "<dateTime>",
                  "description": "Filter absences that start on or before this date"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by absence status"
                },
                {
                  "disabled": false,
                  "key": "userId",
                  "value": "<string>",
                  "description": "Filter absences for a specific user"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination (starts at 1)"
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "100",
                  "description": "Number of results per page"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
