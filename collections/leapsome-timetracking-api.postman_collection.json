            "description": {
              "content": "Get a paginated list of timesheets with optional filtering by username (email) or employee ID. Returns timesheet details including status, dates, and work hour calculations. Requires permission to manage time tracking policies.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "time-tracking",
                "timesheets"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
