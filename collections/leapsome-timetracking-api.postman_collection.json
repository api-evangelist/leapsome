                  "key": "username",
                  "value": "<email>",
                  "description": "Filter by employee email address"
                },
                {
                  "disabled": false,
                  "key": "employeeId",
                  "value": "<string>",
                  "description": "Filter by Leapsome employee ID"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of results to skip"
                },
                {
                  "disabled": false,
